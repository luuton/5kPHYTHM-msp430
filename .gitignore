# ============================================================================
#  5K 下落式节奏游戏 (MSP-EXP430F5529) —— Git 忽略规则
# ============================================================================

# ---------------------------------------------------------------------------
#  CCS / TI 构建产物
#  Debug/ 与 Release/ 整个目录都是自动生成的（含 makefile、.obj、.map、
#  .d/.pp 依赖文件、*_linkInfo.xml），Clean 后由 CCS 重建，不入库。
#  注意：Debug/ 有 11 MB，是整个工作区体积的大头。
# ---------------------------------------------------------------------------
Debug/
Release/
*.obj
*.out
*.map
*.d
*.pp
*_linkInfo.xml
ccsObjs.opt
ccsSrcs.opt
objects.mk
sources.mk
subdir_rules.mk
subdir_vars.mk
macros.ini
.metadata/
.launches/
*.log

# ---------------------------------------------------------------------------
#  Python（report_tools/ 下的辅助脚本）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------------------
#  选题报告及其生成工具 —— 不入库
#  选题报告含个人信息（姓名/学号），且属课程交付物，不公开发布。
#  report_tools/ 是生成该报告的流水线（Visio 画框图、Markdown 转 Word），
#  其中的脚本内含报告的图表文字，故一并排除。
# ---------------------------------------------------------------------------
选题报告*
report_tools/

# ---------------------------------------------------------------------------
#  生成物：可由 report_tools/ 下的脚本重建，不入库
#    · preview.pdf      ← preview_pdf.py
#    · figs/            ← visio_draw.py + emf2png.ps1
#  （选题报告-框图.vsdx 是手工可编辑的源文件，要入库）
# ---------------------------------------------------------------------------
report_tools/preview.pdf
report_tools/figs/

# ---------------------------------------------------------------------------
#  本地编辑器 / 工具设置
#  .clangd 文件头明确写着 "auto-generated file - do not add it to source-control"
#  .claude/ 整个目录保持本地私有：里面是工作流 skill 与本地设置，
#  属于个人工具链，不随项目发布。
# ---------------------------------------------------------------------------
.clangd
.claude/
.vscode/
.idea/
*.theia-workspace.user

# ---------------------------------------------------------------------------
#  体积优化（已启用）：以下文件在 .cproject 里已被 exclude，不参与编译，
#  但合计约 10.6 MB，是本仓库体积的主要来源。取消注释可让仓库瘦到 ~1 MB。
#  这些名字仍留在 .cproject 的 excluding="" 里（无害，路径不存在即视为未排除）。
# ---------------------------------------------------------------------------
#   · rts430xl.lib —— 6.7 MB，TI C 运行时（链接器实际用工具链自带的 libc.a）
#   · MSP-EXP430F5529_UE.lib —— 1.2 MB，TI 原厂 User Experience 库
#   · FatFs/option/*.c —— 合计 2.5 MB，日/简繁中文/韩文码页，未编译
#  注意：.gitignore 里 # 只能整行注释，行尾 # 会被当成 pattern 的一部分。
rts430xl.lib
MSP-EXP430F5529_UE.lib
FatFs/option/cc932.c
FatFs/option/cc936.c
FatFs/option/cc949.c
FatFs/option/cc950.c
FatFs/option/ccsbcs.c
FatFs/option/syscall.c

# ---------------------------------------------------------------------------
#  调试用临时文件
#  串口日志（test.txt / log1.txt / log2.txt ...）是个人调试数据，不入库。
#  如需保留某一份作为样例数据，用 git add -f <文件> 强制加入。
#  注意不要用通配 *.txt：readme.txt、FatFs/00readme.txt 是要入库的。
# ---------------------------------------------------------------------------
test.txt
log*.txt
*.bak
*.tmp
*~
